# ── Playwright test environment ────────────────────────────────
# Copy this file to .env in the ui/ directory and adjust as needed.
# Playwright automatically loads .env via its config.

# Base URL for the deployed stack (Traefik edge proxy).
PLAYWRIGHT_BASE_URL=http://localhost

# Test user credentials — must exist in Keycloak.
# The Playwright suite uses these for login flows.
TEST_USER_EMAIL=user@statistiloto.local
TEST_USER_PASSWORD=user-password-change-me

# Registration test user — a unique email is generated at runtime
# using this prefix. The password must meet Keycloak's realm policy.
TEST_REGISTER_USER_PREFIX=testplayer
TEST_REGISTER_USER_DOMAIN=statistiloto.local
TEST_REGISTER_USER_PASSWORD=test-password-123

# Keycloak admin credentials — used by the test setup helper
# to create the test user if it doesn't exist.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost/auth
KEYCLOAK_REALM=statistiloto
KEYCLOAK_CLIENT_ID=statistiloto-ui

# Whether to auto-create the test user before running tests.
# Set to "true" to have the test suite ensure the user exists.
TEST_AUTO_CREATE_USER=true
